{
  "name": "rgb-color-mixer",
  "description": "A RGB color mixer implemented as a web component",
  "license": "MIT",
  "author": "Benny Schudel",
  "version": "0.8.0",
  "type": "module",
  "types": "dist/types/main.d.ts",
  "exports": {
    ".": {
      "import": "./dist/main.js",
      "types": "./dist/types/main.d.ts"
    },
    "./dist/rgb-color-mixer": "./dist/main.js"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist/"
  ],
  "scripts": {
    "dev": "vite",
    "build": "run-s build:src analyze",
    "build:src": "vite build",
    "preview": "vite preview",
    "analyze": "cem analyze --litelement --outdir dist --exclude pages",
    "e2e": "npx playwright test",
    "e2e:report": "npx playwright show-report",
    "e2e:update": "npx playwright test --update-snapshots",
    "pages:deploy": "./tasks/build-and-deploy-pages.sh"
  },
  "peerDependencies": {
    "color-rgba": "^3.0.0",
    "color-space": "^2.3.1",
    "lit": "^3.2.1",
    "spectral.js": "^3.0.0"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.10.4",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.3",
    "eslint": "^9.26.0",
    "jsdoc": "^4.0.4",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.3",
    "vite": "^6.3.4",
    "vite-plugin-bundlesize": "^0.1.0",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-static-copy": "^2.3.1"
  },
  "customElements": "./dist/custom-elements.json"
}
